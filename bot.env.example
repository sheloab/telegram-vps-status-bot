# Copy to bot.env and chmod 600. Never commit bot.env.
# Dummy values below -- replace with your own.

# From @BotFather (/newbot). Format: <digits>:<35 chars>
BOT_TOKEN=1234567890:AAExampleDummyTokenReplaceMe_abcdefg
# Your own Telegram user/chat ID (ask @userinfobot). Only this chat may use the bot.
ALLOWED_CHAT_ID=123456789

# Optional -- defaults shown.
# Websites in /status are discovered automatically from nginx (every server_name in
# /etc/nginx/sites-enabled; names without a DNS record are listed but not counted as down).
# SITES adds hosts this server doesn't serve. SITE_PATHS sets a check path for hosts whose
# "/" redirects elsewhere (e.g. to a sign-in page).
#SITES=status.example.com
#SITE_PATHS=app.owner-domain01.com=/healthz
# Domain of the nginx site in front of Guacamole (used to find its nginx logs).
#GUAC_DOMAIN=owner-domain01.com
#GUAC_LOG=/var/log/nginx/owner-domain01.com-access.log
#GUAC_ERROR_LOG=/var/log/nginx/owner-domain01.com-error.log
# systemd unit name of this bot, shown in /status (must match the .service file name).
#BOT_SERVICE=telegram-vps-status-bot
# Timezone for dates read from the Guacamole database (IANA name).
#DB_TIMEZONE=UTC
